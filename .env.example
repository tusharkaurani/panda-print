# Environment variables understood by panda-print. All are optional; the values
# shown are the defaults. Use them with `docker run --env-file` or in compose.

# --- server
PORT=8095
HOST=0.0.0.0
LOG_LEVEL=INFO
DATA_DIR=./data              # container: /data
CONFIG_DIR=./config          # container: /config
# SECRET_KEY=                # CSRF signing key; generated into DATA_DIR/secret.key if unset
# TRUSTED_ORIGINS=           # comma-separated extra origins for POSTs (rarely needed)

# --- printers
# Printers are added in the browser (setup wizard on first visit, then the Printers page).
# The values below only prefill the forms and are used for probing; nothing here is required.
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_COUNTER_OID=1.3.6.1.2.1.43.10.2.1.4.1.1
NET_TIMEOUT=5
CUPS_URL=http://127.0.0.1:631
# Unattended installs: if PRINTER_IP is set and no printer exists yet, one is added at start-up.
# PRINTER_IP=192.168.1.18
# PRINTER_IPP_URL=ipp://192.168.1.18/ipp/print
# CUPS_QUEUE=T730

# --- nozzle checks
IDLE_DAYS=7
POLL_INTERVAL=300
# Offered in the wizard (as the printer's timer state file) if this file exists
HOST_STATE_FILE=/host-state/state
NOZZLE_JOB_PATTERN=nozzle-check
ATTRIBUTION_WINDOW=1800
PRINT_COOLDOWN=120
PRINT_MAX_PER_HOUR=5
RECENT_JOBS=10

# --- demo mode
# MOCK=1                     # fake printers + data, no network access needed
# MOCK_SETUP=1               # start mock mode with no printers, to try the setup wizard
# MOCK_FAIL=printer,snmp,cups   # make mock sources fail, to see the error cards
# MOCK_PERSIST=1             # keep mock data in DATA_DIR (default: in memory)
